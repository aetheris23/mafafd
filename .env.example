# =============================================================================
# MAFAFD — Multi-Tenant AI Financial Anomaly & Fraud Detector
# Environment template. Copy to `.env` and fill in real secrets.
# NEVER commit real secrets.
#
# Defaults below run the WHOLE stack natively (no Docker):
#   - PostgreSQL on 127.0.0.1:5433 (user evosynx / password evosynx01)
#   - Redis on 127.0.0.1:6379 (no password)
#   - Message broker: Redis Streams (MQ_PROVIDER=redis) — no RabbitMQ needed
#   - AI: local heuristic (AI_PROVIDER=local) — no API keys needed
# =============================================================================

# --- Global ---
ENV=development
LOG_LEVEL=debug
LOG_FORMAT=console          # console | json

# --- PostgreSQL ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=evosynx
POSTGRES_PASSWORD=evosynx01
POSTGRES_DB=mafafd
DATABASE_URL=postgres://evosynx:evosynx01@127.0.0.1:5433/mafafd?sslmode=disable

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=512         # per-client connection pool (hot path throughput)

# --- Message Broker ---
# rabbit  = production grade (RabbitMQ)  [optional; needs a RabbitMQ server]
# redis   = Redis Streams fallback       [default: local dev, no extra server]
# memory  = in-process channels          [unit tests only]
MQ_PROVIDER=redis
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- Auth ---
JWT_SECRET=local-dev-secret-change-me-0123456789abcdef   # >= 32 chars
JWT_TTL_HOURS=12
TOKEN_BUCKET_RATE_PER_MIN=600        # default token refill rate
TOKEN_BUCKET_BURST=1200              # default burst capacity
SEED_DEMO_DATA=true                  # seed demo tenant/user on gateway boot

# --- AI Assessment (Worker 2) ---
# provider: gemini | openai | local
AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_FALLBACK_LOCAL=true

# --- Ingestion ---
INGESTION_PORT=8080
GATEWAY_PORT=8081
WORKER_CONSUMERS=8
MAX_BODY_BYTES=32768

# --- Service URLs ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Observability (optional; no server included in the native run) ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
